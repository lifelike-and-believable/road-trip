# Names of the settings the app reads. Copy to .env.local for local development;
# never commit real values. On Vercel, set them under Settings, Environment Variables.

# Sign-in
AUTH_SECRET=         # openssl rand -base64 32
APP_PASSCODE=        # the passcode you type to sign in

# Storage (Upstash Redis). The Vercel integration sets the two KV_ values.
DOC_SALT=            # openssl rand -hex 16
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The refresh job authenticates with a bearer token: REFRESH_SECRET by hand, CRON_SECRET from Vercel's scheduler.
REFRESH_SECRET=      # openssl rand -base64 32
CRON_SECRET=        # the same value as REFRESH_SECRET; Vercel's scheduler sends it to /api/refresh

# Finding event sources with Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5   # the default; claude-opus-5-5 costs about twice as much per token

# Optional: an email address or URL OpenStreetMap's services can reach you at
# OSM_CONTACT=
